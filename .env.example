# Django Settings - Environment Template
# =======================================
# Copy this file to .env and fill in your production values.

DJANGO_SECRET_KEY=your-secure-random-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,127.0.0.1

# Database Configuration (Set USE_SQLITE=False for MySQL)
USE_SQLITE=False
DB_NAME=library_portal_db
DB_USER=library_portal_user
DB_PASSWORD=your-database-password-here
DB_HOST=127.0.0.1
DB_PORT=3306

# Production Security & HTTPS Settings (When DJANGO_DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Google OAuth 2.0 / OpenID Connect Settings
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://yourdomain.com/accounts/google/callback/
REQUIRE_MEMBERSHIP_APPROVAL=False
